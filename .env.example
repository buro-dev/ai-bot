# Bu dosyayı ".env" olarak kopyalayıp doldurun. .env dosyası .gitignore ile korunur.
# Kullanım: cp .env.example .env
# Render'da .env KULLANILMAZ; bu değerler servisin "Environment Variables" bölümünden girilir.

# --- Zorunlu ---
# BotFather'dan alınan token
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Botun yanıt vereceği kullanıcının Telegram ID'si (@userinfobot ile öğrenilir)
ALLOWED_USER_ID=123456789
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Kalıcı hafıza için git senkronu (Render'da zorunlu, yerelde önerilir) ---
# İçerik yazma (contents: write) yetkili, BU DEPO'YA özel fine-grained PAT
# (github_pat_...). Render'ın geçici disk'i temizlenince hafıza bu daldan geri yüklenir.
GH_PAT_TOKEN=
# Bilgi amaçlı (opsiyonel): kullanici/depo
GITHUB_REPOSITORY=kullanici/depo
# Hafızanın push edileceği dal (Render'a bağlı dal OLMAMALI; varsayılan: memory)
#GIT_MEMORY_BRANCH=memory
# İki push arası en kısa süre (sn)
#GIT_PUSH_MIN_INTERVAL=15

# --- Çalışma modu ---
# auto: PUBLIC_URL tanımlıysa webhook (Render otomatik tanımlar), değilse poll
#RUN_MODE=auto
# Yalnızca webhook modunda, başka bir sunucuda çalıştırıyorsanız:
#PUBLIC_URL=https://botunuz.oraneginiz.com

# --- Model ayarları (opsiyonel) ---
# Birincil model ve yedekleri (virgülle ayrılmış liste)
#GROQ_MODEL=openai/gpt-oss-120b
#GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
#GROQ_TEMPERATURE=0.7
#GROQ_MAX_TOKENS=1024
#GROQ_TIMEOUT=60
#GROQ_MAX_RETRIES=2

# Sistem istemi (botun kişiliği; boştaysa yerleşik Türkçe asistan istemi kullanılır)
#SYSTEM_PROMPT=

# --- Özellik anahtarları (opsiyonel) ---
#SEARCH_ENABLED=1
#SEARCH_REGION=tr-tr
#SEARCH_MAX_RESULTS=5
#VOICE_ENABLED=1
#WHISPER_MODEL=whisper-large-v3-turbo
#REMINDERS_ENABLED=1
#FILES_ENABLED=1
#TIMEZONE=Europe/Istanbul

# --- Hafıza boyutları (opsiyonel) ---
#MAX_HISTORY_MESSAGES=40
#MAX_PROMPT_CHARS=24000
#MAX_MEMORIES=50
#MAX_PHOTO_BYTES=10485760
#MAX_VOICE_BYTES=10485760
#MAX_DOCUMENT_BYTES=5242880

# --- Geliştirme ---
#DRY_RUN=0
#LOG_LEVEL=INFO
