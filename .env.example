# Bu dosyayı ".env" olarak kopyalayıp doldurun. .env dosyası .gitignore ile korunur.
# Kullanım: cp .env.example .env

# --- Zorunlu ---
# BotFather'dan alınan token
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Botun yanıt vereceği kullanıcının Telegram ID'si (@userinfobot)
ALLOWED_USER_ID=123456789
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Git push (chat_history.json'ı repoya geri göndermek için) ---
# İçerik yazma yetkili fine-grained PAT (github_pat_...) veya klasik token (ghp_...)
GH_PAT_TOKEN=
GITHUB_REPOSITORY=kullanici/depo

# --- Opsiyonel ayarlar ---
# Birincil model ve yedekleri (virgülle ayrılır; yedekler devre dışı: GROQ_DISABLE_FALLBACK_MODELS=1)
#GROQ_MODEL=openai/gpt-oss-120b
#GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile
#GROQ_TEMPERATURE=0.7
#GROQ_MAX_TOKENS=1024
#GROQ_TIMEOUT=60
#GROQ_MAX_RETRIES=2

# Sistem istemi (botun kişiliği/talimatı)
#SYSTEM_PROMPT=Sen yardımcı bir asistansın. Kullanıcı hangi dilde yazarsa o dilde yanıt ver.

# Geçmiş yönetimi: dosya yolu ve en fazla kaç kayıt tutulacak (0 = sınırsız)
#HISTORY_FILE=chat_history.json
#MAX_HISTORY_MESSAGES=40
#MAX_PROMPT_CHARS=24000

# Çalışma modu: auto | once | loop | poll  (auto: Actions'te once, diğerlerinde poll)
#RUN_MODE=auto
#LOOP_MINUTES=5
#LONG_POLL_SECONDS=25
#MAX_ROUNDS=3

# Git ayarları
#GIT_PUSH_ENABLED=1
#GIT_BRANCH=main
#GIT_REMOTE=origin
#GIT_USER_NAME=telegram-ai-bot
#GIT_USER_EMAIL=telegram-ai-bot@users.noreply.github.com
#COMMIT_MESSAGE_PREFIX=sohbet gecmisi

# Uzun döngüler (örn. Actions'taki 5.5 saatlik loop) için otomatik push:
# her yanıtlandıktan sonra commit+push (iki push arası en kısa süre sn)
#GIT_PUSH_AFTER_EACH_MESSAGE=1
#GIT_PUSH_MIN_INTERVAL=15

# Uzun oturumlarda (loop/poll) heartbeat log aralığı (sn)
#HEARTBEAT_SECONDS=60

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
#LOG_LEVEL=INFO

# Yalnızca ID öğrenmek için geçici mod (bu modda bot sohbet yanıtı ÜRETMEZ):
#TELEGRAM_ALLOW_UNAUTHENTICATED_ID=1
